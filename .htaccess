# Tandartspraktijk Slotplantsoen — Apache-configuratie

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Altijd https en zonder www (canonieke domeinnaam)
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://praktijkslotplantsoen.nl%{REQUEST_URI} [L,R=301]

  # Bronbestanden niet publiek
  RewriteRule ^_build/ - [F,L]

  # Oude WordPress-URL's naar de nieuwe pagina's
  RewriteRule ^invisalign/?$ /behandelingen/othodontie-en-invisalign/ [L,R=301]
  RewriteRule ^intake-gebitsprothese/?$ /behandelingen/protheses/ [L,R=301]
  RewriteRule ^homepage/?$ /homepage/praktijkinformatie/ [L,R=301]
  RewriteRule ^author/ / [L,R=301]
  RewriteRule ^(feed|comments/feed)/?$ / [L,R=301]
  RewriteRule ^(wp-login\.php|xmlrpc\.php|wp-admin|wp-json) - [G,L]

  # Slash toevoegen aan mappen zonder slash (bv. /contact -> /contact/)
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^(.*[^/])$ /$1/ [L,R=301]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  <FilesMatch "\.(woff2|webp|png|jpg|ico|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "public, max-age=600"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/xml application/xml application/json image/svg+xml application/manifest+json
</IfModule>

<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType font/woff2 .woff2
  AddType application/manifest+json .webmanifest
</IfModule>
